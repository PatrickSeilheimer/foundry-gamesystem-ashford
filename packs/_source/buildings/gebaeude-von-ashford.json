    {
      "_id": "b949fe7dcef6c448",
      "_key": "!journal.pages!6bfd534c61ee4988.b949fe7dcef6c448",
      "name": "Die Werkstatt",
      "type": "text",
      "title": {
        "show": true,
        "level": 1
      },
      "text": {
        "content": "<p>Hier entstehen die Holzarbeiten der Siedlung: Bauholz aus dem nahen Wald, reparierte Hausteile, die Palisaden selbst und einfache Ausrüstung wie ein simpler Bogen.</p>",
        "format": 1,
        "markdown": ""
      },
      "sort": 600000,
      "ownership": {
        "default": 2
      },
      "flags": {
        "ashford": {
          "slug": "werkstatt",
