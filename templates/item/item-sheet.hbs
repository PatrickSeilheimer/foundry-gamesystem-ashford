<form class="{{cssClass}} flexcol">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" alt="{{item.name}}">
    <div class="header-fields flexcol">
      <input name="name" type="text" value="{{item.name}}" placeholder="Name">
      <span class="item-type-badge">{{localize (concat "ASHFORD.Item." item.type)}}</span>
    </div>
  </header>

  <section class="sheet-body">
    {{#if (eq item.type "trait")}}
      <label>Art
        <select name="system.kind">
          <option value="strength" {{#if (eq system.kind "strength")}}selected{{/if}}>Stärke (+1 Würfel)</option>
          <option value="weakness" {{#if (eq system.kind "weakness")}}selected{{/if}}>Schwäche (−1 Würfel)</option>
        </select>
      </label>
      <label><input type="checkbox" name="system.permanent" {{#if system.permanent}}checked{{/if}}> Permanent</label>
    {{/if}}

    {{#if (eq item.type "talent")}}
      {{#if isCanonicalTalent}}
        <p class="hint">Kanonisches Talent aus der geschlossenen Liste (Abschnitt 5) — Stufe und Waffentalent-Status sind fest.</p>
      {{/if}}
      <label>Stufe (Kostenmultiplikator)
        <input type="number" name="system.stufe" value="{{system.stufe}}" min="1" max="3" {{#if isCanonicalTalent}}disabled{{/if}}>
      </label>
      <label>Stärken (0–3, je +1 Würfel, kostet Stufe × 1 Punkt)
        <input type="number" name="system.staerken" value="{{system.staerken}}" min="0" max="3">
      </label>
      <label>Schwächen (0–2, je −1 Würfel; Stufe 1/2: 1 Punkt pro Schwäche, Stufe 3: 0,5 Punkte pro Schwäche)
        <input type="number" name="system.schwaechen" value="{{system.schwaechen}}" min="0" max="2">
      </label>
      <label><input type="checkbox" name="system.waffentalent" {{#if system.waffentalent}}checked{{/if}} {{#if isCanonicalTalent}}disabled{{/if}}> Waffentalent (bindet dieses Talent an eine Waffen-Kategorie, siehe Feld "Kategorie")</label>
      <label>Kategorie <input type="text" name="system.kategorie" value="{{system.kategorie}}" placeholder="fernkampf, nahkampf_hieb, ..." {{#if isCanonicalTalent}}disabled{{/if}}></label>
      <p class="hint">Würfelzahl: {{diceCount}}. Punkte-Delta: {{signed pointDelta}} (positiv = Rückerstattung, negativ = Kosten).</p>
    {{/if}}

    {{#if (eq item.type "weapon")}}
      <label>Waffentalent
        <select name="system.weaponSkill">
          <option value="">— keins —</option>
          {{#each weaponSkillOptions}}
            <option value="{{this.key}}" {{#if (eq ../system.weaponSkill this.key)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </label>
      <label>Schaden (Würfelausdruck, z.B. 2d6+7 — absolut, bei Nahkampfwaffen kommt der charaktereigene Nahkampfschaden-Bonus beim Wurf automatisch dazu)
        <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="1d6">
      </label>
      <label>Treffer-Bonus (zusätzlich zu Reichweitenklassen bei Fernkampf) <input type="number" name="system.accuracyBonus" value="{{system.accuracyBonus}}"></label>
      <label>Initiative-Modifikator (während geführt) <input type="number" name="system.initiativeMod" value="{{system.initiativeMod}}"></label>
      <label><input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}> Aktuell geführt (unabhängig von den Körper-Slots)</label>
      <label>Munition <input type="text" name="system.ammo" value="{{system.ammo}}"></label>
    {{/if}}

    {{#if (eq item.type "armor")}}
      <h4>Rüstung (je Schadensart)</h4>
      <div class="armor-type-grid">
        <label>🔫 Ballistic <input type="number" name="system.armor.ballistic" value="{{system.armor.ballistic}}" min="0"></label>
        <label>🗡 Pierce <input type="number" name="system.armor.pierce" value="{{system.armor.pierce}}" min="0"></label>
        <label>🔨 Blunt <input type="number" name="system.armor.blunt" value="{{system.armor.blunt}}" min="0"></label>
        <label>⚔ Slash <input type="number" name="system.armor.slash" value="{{system.armor.slash}}" min="0"></label>
      </div>
      <label>Ausrüstungsslot
        <select name="system.slot">
          <option value="">— keiner —</option>
          {{#each equipSlotOptions}}
            <option value="{{this.key}}" {{#if (eq ../system.slot this.key)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </label>
      <label><input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}> Angelegt</label>
      <label>Initiative-Modifikator (während angelegt) <input type="number" name="system.initiativeMod" value="{{system.initiativeMod}}"></label>
      <label>Nahkampfschaden-Bonus (z.B. Schlagring) <input type="number" name="system.meleeDamageBonus" value="{{system.meleeDamageBonus}}"></label>

      <h4>Talent-Boni</h4>
      <p class="hint">Flacher Bonus/Malus aufs Würfelergebnis (nicht auf den Würfelpool) des gewählten Talents, solange dieses Item angelegt ist.</p>
      <ol class="fact-list ashford-effect-list">
        {{#each system.talentBonuses as |bonus index|}}
          <li>
            <select name="system.talentBonuses.{{index}}.talentKey">
              <option value="">— Talent wählen —</option>
              {{#each ../talentOptions}}
                <option value="{{this.key}}" {{#if (eq bonus.talentKey this.key)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
            <input type="number" name="system.talentBonuses.{{index}}.value" value="{{bonus.value}}">
            <a class="ashford-talentbonus-remove" data-index="{{index}}" title="Entfernen"><i class="fas fa-trash"></i></a>
          </li>
        {{/each}}
      </ol>
      <a class="item-create ashford-talentbonus-add">+ Talent-Bonus</a>
    {{/if}}

    {{#if (or (eq item.type "equipment") (eq item.type "consumable"))}}
      <label>Kategorie
        <select name="system.category">
          {{#each itemCategoryOptions}}
            <option value="{{this.key}}" {{#if (eq ../system.category this.key)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </label>
    {{/if}}

    {{#if (eq item.type "consumable")}}
      <label>Verbleibende Nutzungen <input type="number" name="system.usesRemaining" value="{{system.usesRemaining}}"></label>
      <label>Aktions-Label <input type="text" name="system.actionLabel" value="{{system.actionLabel}}" placeholder="Benutzen / Essen / Trinken / Anwenden"></label>

      <h4>Combi-Item</h4>
      <p class="hint">Falls gefüllt: Benutzen erzeugt diese Consumables im Inventar und löscht DIESES Item komplett (z.B. Erste-Hilfe-Kasten). Leer lassen für ein normales Einzel-Item.</p>
      <ol class="fact-list ashford-effect-list">
        {{#each system.comboItems as |entry index|}}
          <li>
            <input type="text" name="system.comboItems.{{index}}.name" value="{{entry.name}}" placeholder="Name, z.B. Verband">
            <input type="number" name="system.comboItems.{{index}}.quantity" value="{{entry.quantity}}" min="1">
            <a class="ashford-combo-remove" data-index="{{index}}" title="Entfernen"><i class="fas fa-trash"></i></a>
          </li>
        {{/each}}
      </ol>
      <a class="item-create ashford-combo-add">+ Inhalt</a>
    {{/if}}

    {{#if (eq item.type "condition")}}
      <label>Katalog-Schlüssel (leer = Homebrew) <input type="text" name="system.conditionKey" value="{{system.conditionKey}}"></label>
      <label>Kategorie
        <select name="system.category">
          {{#each conditionCategories}}
            <option value="{{this.key}}" {{#if (eq ../system.category this.key)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>Schweregrad
        <select name="system.severity">
          {{#each conditionSeverities}}
            <option value="{{this}}" {{#if (eq ../system.severity this)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </label>
      <label><input type="checkbox" name="system.active" {{#if system.active}}checked{{/if}}> Aktiv (deaktiviert = archiviert statt gelöscht)</label>
      <label>Quelle <input type="text" name="system.source" value="{{system.source}}" placeholder="z.B. Zombie-Biss"></label>
      <label>Notiz <input type="text" name="system.note" value="{{system.note}}"></label>

      <h4>Dauer</h4>
      <label>Typ
        <select name="system.duration.type">
          {{#each conditionDurationTypes}}
            <option value="{{this.key}}" {{#if (eq ../system.duration.type this.key)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>Wert <input type="number" name="system.duration.value" value="{{system.duration.value}}" min="0"></label>
      <label>Ereignis-Text (bei "Bis Ereignis") <input type="text" name="system.duration.eventLabel" value="{{system.duration.eventLabel}}"></label>

      <h4>Auswirkungen</h4>
      <p class="hint">talentMod wirkt automatisch beim Würfeln dieses Talents. derivedMod verschiebt Ausweichen/initiativeMod/nahkampfschaden/healthMax direkt. note ist rein beschreibend.</p>
      <ol class="fact-list ashford-effect-list">
        {{#each system.effects as |effect index|}}
          <li>
            <select name="system.effects.{{index}}.mode">
              <option value="note" {{#if (eq effect.mode "note")}}selected{{/if}}>Notiz</option>
              <option value="talentMod" {{#if (eq effect.mode "talentMod")}}selected{{/if}}>Talent-Mod.</option>
              <option value="derivedMod" {{#if (eq effect.mode "derivedMod")}}selected{{/if}}>Wert-Mod.</option>
            </select>
            <input type="text" name="system.effects.{{index}}.key" value="{{effect.key}}" placeholder="Talent-Key / Wert-Key">
            <input type="number" name="system.effects.{{index}}.value" value="{{effect.value}}">
            <input type="text" name="system.effects.{{index}}.label" value="{{effect.label}}" placeholder="Anzeige-Label">
            <a class="ashford-effect-remove" data-index="{{index}}" title="Entfernen"><i class="fas fa-trash"></i></a>
          </li>
        {{/each}}
      </ol>
      <a class="item-create ashford-effect-add">+ Auswirkung</a>
    {{/if}}

    {{#if (or (eq item.type "weapon") (eq item.type "armor") (eq item.type "equipment") (eq item.type "consumable"))}}
      <label>Menge <input type="number" name="system.quantity" value="{{system.quantity}}"></label>
      <label>Gewicht <input type="number" name="system.weight" value="{{system.weight}}"></label>
    {{/if}}

    <h3>Beschreibung</h3>
    {{editor system.description target="system.description" button=true engine="prosemirror" collaborate=false}}
  </section>
</form>
