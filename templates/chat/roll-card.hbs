<div class="ashford-roll-card">
  {{#if autoFail}}
    <header>
      <strong>{{label}}</strong>
    </header>
    <div class="auto-fail">Automatischer Fehlschlag{{#if autoFailReason}} — {{autoFailReason}}{{/if}}</div>
  {{else}}
    <header>
      <strong>{{label}}</strong>
      <span class="pool-size">{{diceCount}}W6, explodierend</span>
    </header>
    <div class="dice-row">
      {{#each dice}}
        <span class="die {{#if this.exploded}}exploded{{/if}}">{{this.result}}</span>
      {{/each}}
    </div>
    <div class="total-row">
      <span class="dice-total">Würfelsumme: {{diceTotal}}</span>
      {{#if modifier}}
        <span class="modifier">{{modifierLabel}}: {{#if (gte modifier 0)}}+{{/if}}{{modifier}}</span>
      {{/if}}
      <span class="grand-total">Ergebnis: {{total}}</span>
    </div>
    {{#if targetLabel}}
      <div class="result-row {{#if success}}success{{else}}failure{{/if}}">
        {{targetLabel}} — {{#if success}}Erfolg{{else}}Fehlschlag{{/if}}
      </div>
    {{/if}}
    {{#if strengthNames.length}}
      <div class="tags strengths">Stärken: {{#each strengthNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
    {{/if}}
    {{#if weaknessNames.length}}
      <div class="tags weaknesses">Schwächen: {{#each weaknessNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</div>
    {{/if}}
  {{/if}}
</div>
