<div class="ashford-damage-card">
  <header>
    <strong>{{weaponName}}</strong> → {{targetName}}
  </header>
  <div class="damage-row">Rohschaden: <span class="raw">{{rawDamage}}</span></div>
  {{#if armorValue}}
    <div class="damage-row">Rüstung ({{damageTypeLabel}}): <span class="armor">−{{armorValue}}</span></div>
  {{/if}}
  <div class="damage-row final">Effektiver Schaden: <span class="final">{{finalDamage}}</span></div>
  {{#if resolved}}
    <div class="damage-resolved">
      {{#if reverted}}
        <span class="reverted-label">Rückgängig gemacht.</span>
      {{else}}
        <span>Angewendet: −{{finalDamage}} LP bei {{targetName}}</span>
        <button type="button" class="ashford-damage-undo">Rückgängig machen</button>
      {{/if}}
    </div>
  {{else}}
    <div class="damage-pending hint">Wird angewendet …</div>
  {{/if}}
</div>
