<div class="ashford-combat-hud-bar">
  {{#each combatants}}
    <div class="chud-portrait {{#if this.active}}active{{/if}} {{#if this.defeated}}defeated{{/if}}"
         data-combatant-id="{{this.id}}" title="{{this.name}}">
      <div class="chud-frame">
        <img src="{{this.img}}" alt="{{this.name}}">
      </div>
      <div class="chud-health"><div class="chud-health-fill" style="width:{{this.healthPct}}%"></div></div>
      <div class="chud-name">{{this.name}}</div>
      {{#if this.shotDots.length}}
        <div class="chud-shots">
          {{#each this.shotDots}}
            <span class="chud-shot-dot {{this}}"></span>
          {{/each}}
        </div>
      {{/if}}
      {{#if this.ammoLabel}}
        <div class="chud-ammo" title="Nur für den Spielleiter sichtbar">{{this.ammoLabel}}</div>
      {{/if}}
    </div>
  {{/each}}
</div>
