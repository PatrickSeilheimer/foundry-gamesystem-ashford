<form class="ashford-condition-picker-form">
  <div class="cp-search-row">
    <input type="search" name="cp-search" placeholder="🔎 Zustand suchen...">
  </div>

  <div class="cp-chip-row">
    <span class="cp-chip active" data-category="all">Alle</span>
    {{#each categories}}
      <span class="cp-chip" data-category="{{this.key}}">{{this.label}}</span>
    {{/each}}
  </div>

  <div class="cp-condition-list">
    {{#each conditions}}
      <div class="cp-condition-row" data-key="{{this.key}}" data-category="{{this.category}}" data-severity="{{this.severity}}" data-name="{{this.name}}" data-description="{{this.description}}">
        <i class="cp-icon {{this.icon}} severity-{{this.severity}}"></i>
        <span class="cp-condition-name">{{this.name}}</span>
        <span class="cp-severity-badge severity-{{this.severity}}">{{this.severity}}</span>
      </div>
    {{/each}}
  </div>

  <input type="hidden" name="conditionKey" value="">

  <p class="cp-selected-hint">Kein Zustand ausgewählt.</p>

  <fieldset class="cp-details">
    <legend>Details</legend>
    <label>Schweregrad
      <select name="severity">
        {{#each severities}}
          <option value="{{this}}">{{this}}</option>
        {{/each}}
      </select>
    </label>
    <label>Quelle <input type="text" name="source" placeholder="z.B. Zombie-Biss"></label>
    <label>Dauer-Typ
      <select name="durationType">
        {{#each durationTypes}}
          <option value="{{this.key}}">{{this.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>Dauer-Wert <input type="number" name="durationValue" value="0" min="0"></label>
    <label>Ereignis-Text (bei "Bis Ereignis") <input type="text" name="eventLabel" placeholder="z.B. bis behandelt"></label>
    <label>Notiz <textarea name="note" rows="2" placeholder="Optional"></textarea></label>
  </fieldset>
</form>
