<form class="{{cssClass}} flexcol">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}">
    <div class="header-fields flexcol">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Name">
      <input name="system.role" type="text" value="{{system.role}}" placeholder="{{localize 'ASHFORD.Sheet.role'}}">
      <div class="resource-row">
        <label>{{localize "ASHFORD.Sheet.health"}}
          <input type="number" name="system.resources.health.value" value="{{system.resources.health.value}}">
          / <input type="number" name="system.resources.health.max" value="{{system.resources.health.max}}">
        </label>
        <label>Gebäude (Kodex-ID) <input type="text" name="system.buildingId" value="{{system.buildingId}}"></label>
      </div>
      <button type="button" class="ashford-roll-pool">🎲 {{localize "ASHFORD.Sheet.rollPool"}}</button>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="main">Übersicht</a>
    <a class="item" data-tab="codex">Kodex-Eintrag</a>
    <a class="item" data-tab="traits">{{localize "ASHFORD.Sheet.traits"}}</a>
    <a class="item" data-tab="gear">{{localize "ASHFORD.Sheet.gear"}}</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="main">
      <label><input type="checkbox" name="system.isCodexEntry" {{#if system.isCodexEntry}}checked{{/if}}> Im Ashford-Kodex sichtbar</label>
      <h3>{{localize "ASHFORD.Sheet.biography"}} (GM-Notizen)</h3>
      {{editor system.biography target="system.biography" button=true engine="prosemirror" collaborate=false}}
    </div>

    <div class="tab" data-group="primary" data-tab="codex">
      <h3>{{localize "ASHFORD.Sheet.facts"}}</h3>
      <ol class="fact-list">
        {{#each system.facts as |fact|}}
          <li>
            <input type="text" name="system.facts.{{@index}}.label" value="{{fact.label}}" placeholder="Label">
            <input type="text" name="system.facts.{{@index}}.value" value="{{fact.value}}" placeholder="Wert">
          </li>
        {{/each}}
      </ol>
      <h3>{{localize "ASHFORD.Sheet.story"}}</h3>
      {{editor system.story target="system.story" button=true engine="prosemirror" collaborate=false}}
      <h3>Notiz (statt Gebäude)</h3>
      {{editor system.note target="system.note" button=true engine="prosemirror" collaborate=false}}
    </div>

    <div class="tab" data-group="primary" data-tab="traits">
      <ol class="item-list">
        {{#each traits as |item|}}
          <li class="item" data-item-id="{{item.id}}">
            <span class="item-name">{{item.name}}</span>
            <span class="item-kind">{{item.system.kind}}</span>
            <a class="item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-delete"><i class="fas fa-trash"></i></a>
          </li>
        {{/each}}
      </ol>
      <a class="item-create" data-type="trait">+ Stärke/Schwäche</a>
    </div>

    <div class="tab" data-group="primary" data-tab="gear">
      <ol class="item-list">
        {{#each gear as |item|}}
          <li class="item" data-item-id="{{item.id}}">
            <span class="item-name">{{item.name}}</span>
            <a class="item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-delete"><i class="fas fa-trash"></i></a>
          </li>
        {{/each}}
      </ol>
      <a class="item-create" data-type="weapon">+ Waffe</a>
    </div>
  </section>
</form>
