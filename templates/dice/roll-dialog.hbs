<form class="ashford-roll-dialog">
  <p class="hint">
    Basis: <strong>{{baseStaerken}}</strong> Stärke(n), <strong>{{baseSchwaechen}}</strong> Schwäche(n) auf {{talentName}}.
    Würfelzahl = 3 + Stärken − Schwächen, alle Würfel W6 und explodierend.
  </p>

  <fieldset>
    <legend>Permanente Stärken</legend>
    {{#each permanentStrengths}}
      <label class="ashford-trait-toggle">
        <input type="checkbox" data-kind="strength" data-name="{{this.name}}" checked>
        {{this.name}}
      </label>
    {{else}}
      <p class="hint">Keine permanenten Stärken.</p>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend>Permanente Schwächen</legend>
    {{#each permanentWeaknesses}}
      <label class="ashford-trait-toggle">
        <input type="checkbox" data-kind="weakness" data-name="{{this.name}}" checked>
        {{this.name}}
      </label>
    {{else}}
      <p class="hint">Keine permanenten Schwächen.</p>
    {{/each}}
  </fieldset>

  {{#if conditionNames.length}}
    <fieldset class="ashford-condition-hint">
      <legend>Aktive Zustände (automatisch einberechnet)</legend>
      <p class="hint">{{#each conditionNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}} → {{signed conditionNet}} Würfel</p>
    </fieldset>
  {{/if}}

  {{#if gearNames.length}}
    <fieldset class="ashford-condition-hint">
      <legend>Ausrüstung (automatisch einberechnet, aufs Ergebnis)</legend>
      <p class="hint">{{#each gearNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}} → {{signed gearFlatBonus}} auf das Ergebnis</p>
    </fieldset>
  {{/if}}

  {{#if weaponAccuracyBonus}}
    <fieldset class="ashford-condition-hint">
      <legend>Waffe (automatisch einberechnet, aufs Ergebnis)</legend>
      <p class="hint">{{weaponName}} → {{signed weaponAccuracyBonus}} auf das Ergebnis</p>
    </fieldset>
  {{/if}}

  <fieldset>
    <legend>Situativ (nur diese Probe)</legend>
    <label>
      Zusätzliche Stärken
      <input type="number" name="extraStaerken" value="0" min="0">
    </label>
    <label>
      Zusätzliche Schwächen
      <input type="number" name="extraSchwaechen" value="0" min="0">
    </label>
    <label>
      Fester Modifikator (auf die Summe)
      <input type="number" name="flatModifier" value="0">
    </label>
  </fieldset>

  <fieldset>
    <legend>Zielwert</legend>
    <label class="ashford-radio-row">
      <input type="radio" name="targetMode" value="none" checked> Kein Zielwert, nur Ergebnis
    </label>
    <label class="ashford-radio-row">
      <input type="radio" name="targetMode" value="difficulty"> Schwierigkeit
      <select name="difficulty">
        {{#each difficulties}}
          <option value="{{this.key}}">{{this.label}} ({{this.target}})</option>
        {{/each}}
      </select>
    </label>
    <label class="ashford-radio-row">
      <input type="radio" name="targetMode" value="custom"> Fester Zielwert
      <input type="number" name="customTarget" value="12">
    </label>
    {{#if isWeapon}}
      <label class="ashford-radio-row">
        <input type="radio" name="targetMode" value="attack"> Angriff gegen Ausweichen
        <input type="number" name="ausweichenValue" value="{{#if targetAusweichen}}{{targetAusweichen}}{{else}}10{{/if}}">
        {{#if targetName}}<span class="hint">(Ziel: {{targetName}})</span>{{/if}}
      </label>
      {{#if isRanged}}
        <label>
          Entfernung (Meter)
          <input type="number" name="rangeMeters" value="0" min="0">
        </label>
      {{/if}}
    {{/if}}
  </fieldset>
</form>
